# Gemini Developer API (AI Studio): required for Gemini API routes unless you use Vertex below.
GEMINI_API_KEY=your-google-ai-studio-api-key
# GOOGLE_API_KEY=your-google-ai-studio-api-key

# Vertex AI only: GCP project numeric ID/string (NOT your Gemini API key) + ADC.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VEO_MODEL=veo-3.1-generate-preview
# Veo clip length: Gemini API key mode is capped at 8s by Google (raise VEO_DURATION_MAX on Vertex-only).
VEO_DURATION_SECONDS=8
VEO_DURATION_MAX=60
VEO_ASPECT_RATIO=16:9
VEO_POLL_SECONDS=10
# When true, Veo also synthesizes ambient/dialogue-ish audio internally (distinct from ElevenLabs cast voices).
VEO_GENERATE_NATIVE_AUDIO=false
IMAGEN_MODEL=imagen-3.0-generate-002
# Pause milliseconds between stitched dialogue clips (mixed MP3 output).
DIALOGUE_PAUSE_MS=280
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ARYAN_ID=voice-id-for-aryan
ELEVENLABS_VOICE_SARA_ID=voice-id-for-sara
ELEVENLABS_VOICE_ROHAN_ID=voice-id-for-rohan
FRONTEND_ORIGIN=http://localhost:5173

# Speech pipeline: elevenlabs | edge | auto (auto prefers ElevenLabs when key + speaker voice ids exist; else Edge TTS — free, no key).
TTS_BACKEND=auto
EDGE_VOICE_ARYAN=en-IN-PrabhatNeural
EDGE_VOICE_SARA=en-IN-NeerjaNeural
EDGE_VOICE_ROHAN=en-US-GuyNeural

# ElevenLabs offers a free tier with monthly character quota (requires signup at elevenlabs.io); paid plans unlock commercial use.

# Offline smoke test only: ffmpeg solid-color slate instead of Veo (omit or false in production).
ALLOW_PLACEHOLDER_VIDEO=false
